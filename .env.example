# ============================================================================
# Plan-E Travel Reservation Ecosystem: Environment Variables
# ============================================================================

# Environment: development | staging | production | testing
ENVIRONMENT=production
PROJECT_NAME="Plan-E Travel Reservation Engine"
VERSION="1.0.0"

# Application Ports
API_PORT=8000
WEB_PORT=80
DB_PORT=5432

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=plane_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/plane_db

# Security & JWT Authentication
SECRET_KEY=super-secret-jwt-key-for-plane-ota-development-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Business Pricing Engine Parameters
PLATFORM_FEE_PERCENTAGE=5.0
DEFAULT_TAX_PERCENTAGE=8.5

# Mapbox GL SDK Configuration
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoicGxhbmUtdHJhdmVsIiwiYSI6ImNsdGVzdHRva2VuIn0.demo
